+// Keep native caption controls outside the URL island. The narrow-screen
+// fallback shrinks the island naturally rather than clipping browser controls.
+BrowserLayoutParams GetIslandTopContainerParams(BrowserLayoutParams params) {
+  constexpr int kIslandMaxWidth = 960;
+  const int leading = std::max(
+      kZenModeVTSPadding,
+      base::ClampCeil(params.leading_exclusion.ContentWithPadding().width()) +
+          kZenModeVTSPadding);
+  const int trailing = std::max(
+      kZenModeVTSPadding,
+      base::ClampCeil(params.trailing_exclusion.ContentWithPadding().width()) +
+          kZenModeVTSPadding);
+  params.Inset(gfx::Insets::TLBR(kZenModeVTSPadding, leading, 0, trailing));
+  const int extra =
+      std::max(0, params.visual_client_area.width() - kIslandMaxWidth);
+  params.Inset(gfx::Insets::TLBR(0, extra / 2, 0, extra - extra / 2));
+  return params;
+}
