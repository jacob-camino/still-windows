 #include "base/trace_event/trace_event.h"
 #include "base/values.h"
@@ -39,6 +40,7 @@
 #include "chrome/browser/extensions/external_pref_loader.h"
 #include "chrome/browser/extensions/forced_extensions/install_stage_tracker_factory.h"
 #include "chrome/browser/extensions/initial_external_extension_loader.h"
+#include "chrome/browser/extensions/still_blocking/identity.h"
 #include "chrome/browser/policy/profile_policy_connector.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/profiles/profiles_state.h"
@@ -101,6 +103,30 @@
 using ::base::i18n::LanguageTag;
 using ::base::i18n::LanguageTagConverter;
 
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX)
+// A normal, removable extension supplied by the signed browser distribution.
+// The standard CRX installer verifies its signature, ID, version and permissions.
+class StillBlockingLoader : public ExternalLoader {
+ public:
+  void StartLoading() override {
+    base::DictValue prefs;
+    base::FilePath resources;
+    if (base::PathService::Get(chrome::DIR_RESOURCES, &resources)) {
+      base::DictValue extension;
+      extension.Set(ExternalProviderImpl::kExternalCrx,
+                    resources.AppendASCII("still-blocking.crx").AsUTF8Unsafe());
+      extension.Set(ExternalProviderImpl::kExternalVersion,
+                    still_blocking::kVersion);
+      prefs.Set(still_blocking::kExtensionId, std::move(extension));
+    }
+    LoadFinished(std::move(prefs));
+  }
+
+ private:
+  ~StillBlockingLoader() override = default;
+};
+#endif
+
 #if BUILDFLAG(IS_CHROMEOS)
 
 const char kCameraAppId[] = "hfhhnacclhffhdffklopdkcgdhifgngh";
@@ -908,6 +934,22 @@
       Extension::FROM_WEBSTORE | Extension::WAS_INSTALLED_BY_DEFAULT));
 #endif
 
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX)
+  // Follow the existing first-profile preinstall decision. On later launches,
+  // only update an existing installation; never undo a user's removal.
+  if (preinstalled_extensions::Provider::DidPerformNewInstallationForProfile(
+          profile) ||
+      ExtensionRegistry::Get(profile)->GetExtensionById(
+          still_blocking::kExtensionId, ExtensionRegistry::EVERYTHING)) {
+    auto still_provider = std::make_unique<ExternalProviderImpl>(
+        service, base::MakeRefCounted<StillBlockingLoader>(), profile,
+        ManifestLocation::kInternal, ManifestLocation::kInvalidLocation,
+        Extension::WAS_INSTALLED_BY_DEFAULT);
+    still_provider->set_auto_acknowledge(true);
+    provider_list->push_back(std::move(still_provider));
+  }
+#endif
