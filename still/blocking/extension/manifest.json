{
  "manifest_version": 3,
  "name": "Still — blocked sites",
  "version": "0.1.0",
  "description": "Local website controls for Still. No cloud classification or browsing telemetry.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Still — blocked sites"
  },
  "options_page": "settings.html",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; connect-src 'self'"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult",
        "enabled": true,
        "path": "data/adult-rules.json"
      }
    ]
  },
  "key": ""
}
